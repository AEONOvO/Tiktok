<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black" tools:context=".ui.fragment.HomeFragment">

    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPager" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="48dp"/>

    <RelativeLayout android:id="@+id/rl_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <com.google.android.material.tabs.TabLayout android:id="@+id/tabTitle" android:layout_width="wrap_content" android:layout_height="45dp" android:layout_centerInParent="true" android:background="@color/transparent" app:tabGravity="center" app:tabIndicatorColor="#FF9F00" app:tabIndicatorFullWidth="false" app:tabIndicatorGravity="bottom" app:tabIndicatorHeight="3dp" app:tabMinWidth="60dp" app:tabMode="auto" app:tabPaddingEnd="20dp" app:tabPaddingStart="20dp" app:tabRippleColor="@android:color/transparent" app:tabSelectedTextColor="@color/white" app:tabTextAppearance="@style/TabTextStyle" app:tabTextColor="#CCCCCC" />

        <ImageView android:id="@+id/iv_search" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:layout_marginRight="10dp" android:background="@mipmap/iv_search" />

    </RelativeLayout>

    <TextView android:id="@+id/tv_ai_float" android:layout_width="56dp" android:layout_height="56dp" android:layout_alignParentEnd="true" android:layout_alignParentBottom="true" android:layout_marginEnd="16dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_ai_float" android:gravity="center" android:text="AI" android:textColor="@color/white" android:textSize="16sp" />
</RelativeLayout>
